package rpc

import (
	"context"
	"time"

	"github.com/go-kratos/kratos/v2/middleware/metadata"
	"github.com/go-kratos/kratos/v2/middleware/tracing"
	"github.com/go-kratos/kratos/v2/transport/grpc"
	"gl.quanyougame.net/common/core-sdk-go/zaplog"
	pb "gl.quanyougame.net/common/idl_gen/sports_meta"
	"go.uber.org/zap"

	"[[.Module]]/infra/nacos"
	"[[.Module]]/pkg/utils"
)

// sportsMetaSrvName 赛事元数据服务 gRPC 注册名，按实际情况修改。
var sportsMetaSrvName = "qy.fantasy.sports_meta.grpc"

var sportsMetaCli *SportsMetaClient

// SportsMetaClient 赛事元数据 RPC 客户端。
type SportsMetaClient struct {
	client pb.SportsMetaClient
}

// initSportsMetaClient 初始化赛事元数据服务客户端（通过 Nacos 服务发现）。
func initSportsMetaClient() {
	log := zaplog.Log()
	endpoint := utils.GenEndpoint(sportsMetaSrvName)
	conn, err := grpc.DialInsecure(
		context.Background(),
		grpc.WithEndpoint(endpoint),
		grpc.WithDiscovery(nacos.GetRegistrar()),
		grpc.WithTimeout(10*time.Second),
		grpc.WithMiddleware(
			tracing.Client(),
			metadata.Client(),
		),
	)
	if err != nil {
		log.Fatal("failed to initialize sports meta service client",
			zap.String("service", sportsMetaSrvName),
			zap.String("endpoint", endpoint),
			zap.Error(err),
		)
	}

	log.Info("initialized sports meta service client",
		zap.String("service", sportsMetaSrvName),
		zap.String("endpoint", endpoint),
	)
	sportsMetaCli = &SportsMetaClient{client: pb.NewSportsMetaClient(conn)}
}

// GetSportsMetaClient 获取赛事元数据客户端。
func GetSportsMetaClient() *SportsMetaClient {
	return sportsMetaCli
}

// MGetMatch 批量获取赛事元数据。
func (c *SportsMetaClient) MGetMatch(ctx context.Context, matchIDs []int64) (*pb.MGetMatchResponse, error) {
	if len(matchIDs) == 0 {
		return &pb.MGetMatchResponse{}, nil
	}
	resp, err := c.client.MGetMatch(ctx, &pb.MGetMatchRequest{Ids: matchIDs})
	if err != nil {
		zaplog.Log(ctx).Error("failed to get match meta", zap.Int64s("match_ids", matchIDs), zap.Error(err))
		return nil, err
	}
	return resp, nil
}
