package rpc

import (
	"context"
	"fmt"

	"github.com/go-kratos/kratos/v2/middleware/metadata"
	"github.com/go-kratos/kratos/v2/middleware/tracing"
	"github.com/go-kratos/kratos/v2/transport/grpc"
	"glprivate.quanyougame.net/backend/core-sdk-go/zaplog"
	pb "glprivate.quanyougame.net/backend/idl_gen/kbfs_user"
	"go.uber.org/zap"

	"[[.Module]]/infra/nacos"
	"[[.Module]]/pkg/utils"
)

// userSrvName 用户服务 gRPC 注册名，按实际情况修改。
var userSrvName = "qy.kbfs.user.grpc"

var userCli *UserClient

// UserClient 用户服务 RPC 客户端。
type UserClient struct {
	userCli   pb.UserServiceClient
	walletCli pb.WalletServiceClient
}

// initUserClient 初始化用户服务客户端（通过 Nacos 服务发现）。
func initUserClient() {
	log := zaplog.Log()
	endpoint := utils.GenEndpoint(userSrvName)
	conn, err := grpc.DialInsecure(
		context.Background(),
		grpc.WithEndpoint(endpoint),
		grpc.WithDiscovery(nacos.GetRegistrar()),
		grpc.WithUnaryInterceptor(unaryRetryInterceptor(userSrvName)),
		grpc.WithMiddleware(
			tracing.Client(),
			metadata.Client(),
		),
	)
	if err != nil {
		log.Fatal("failed to initialize user service client",
			zap.String("service", userSrvName),
			zap.String("endpoint", endpoint),
			zap.Error(err),
		)
	}

	log.Info("initialized user service client",
		zap.String("service", userSrvName),
		zap.String("endpoint", endpoint),
	)
	userCli = &UserClient{
		userCli:   pb.NewUserServiceClient(conn),
		walletCli: pb.NewWalletServiceClient(conn),
	}
}

// GetUserClient 获取用户服务客户端。
func GetUserClient() *UserClient {
	return userCli
}

// GetBatchUserInfo 批量获取用户信息。
func (c *UserClient) GetBatchUserInfo(ctx context.Context, userIDs []int64) ([]*pb.UserInfoReply, error) {
	log := zaplog.Log(ctx).With(zap.Int64s("user_ids", userIDs))
	resp, err := c.userCli.GetBatchUserInfo(ctx, &pb.GetBatchUserInfoRequest{UserIds: userIDs})
	if err != nil {
		log.Error("failed to get batch user info", zap.Error(err))
		return nil, err
	}
	if resp.BaseResp == nil || resp.BaseResp.Code != 0 {
		log.Error("failed to get batch user info",
			zap.Int32("code", resp.BaseResp.Code),
			zap.String("msg", resp.BaseResp.Msg))
		return nil, fmt.Errorf("failed to get batch user info, code=%d, msg=%s", resp.BaseResp.Code, resp.BaseResp.Msg)
	}
	return resp.Users, nil
}

// GetBalance 获取用户钱包余额。
func (c *UserClient) GetBalance(ctx context.Context, userID int64) (float64, error) {
	log := zaplog.Log(ctx).With(zap.Int64("user_id", userID))
	resp, err := c.walletCli.GetWallet(ctx, &pb.GetWalletRequest{UserId: userID})
	if err != nil {
		log.Error("failed to get user balance", zap.Error(err))
		return 0, err
	}
	if resp.BaseResp != nil && resp.BaseResp.Code != 0 {
		return 0, fmt.Errorf("failed to get balance, code=%d, msg=%s", resp.BaseResp.Code, resp.BaseResp.Msg)
	}
	return resp.Balance, nil
}
