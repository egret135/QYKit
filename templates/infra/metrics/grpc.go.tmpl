package metrics

import (
	"context"
	"strings"
	"time"

	"github.com/go-kratos/kratos/v2/middleware"
	"github.com/go-kratos/kratos/v2/transport"
	"github.com/go-kratos/kratos/v2/transport/grpc"
	"go.opentelemetry.io/otel/attribute"
	"go.opentelemetry.io/otel/metric"
	"google.golang.org/grpc/codes"
	"google.golang.org/grpc/status"
)

// GRPCOtelMetrics gRPC OTel 指标中间件。
func GRPCOtelMetrics() middleware.Middleware {
	return func(handler middleware.Handler) middleware.Handler {
		return func(ctx context.Context, req interface{}) (interface{}, error) {
			var (
				service string
				method  string
			)

			if tr, ok := transport.FromServerContext(ctx); ok {
				if gt, ok := tr.(*grpc.Transport); ok {
					operation := gt.Operation()
					parts := strings.Split(operation, "/")
					if len(parts) >= 3 {
						serviceParts := strings.Split(parts[1], ".")
						if len(serviceParts) > 0 {
							service = serviceParts[len(serviceParts)-1]
						}
						method = parts[2]
					}
				}
			}

			attrs := []attribute.KeyValue{
				attribute.String("service", service),
				attribute.String("method", method),
			}

			GRPCRequestsInFlight.Add(ctx, 1, metric.WithAttributes(attrs...))
			defer GRPCRequestsInFlight.Add(ctx, -1, metric.WithAttributes(attrs...))

			startTime := time.Now()
			reply, err := handler(ctx, req)
			duration := time.Since(startTime).Seconds()

			statusCode := codes.OK.String()
			if err != nil {
				if st, ok := status.FromError(err); ok {
					statusCode = st.Code().String()
				} else {
					statusCode = codes.Unknown.String()
				}
			}

			finalAttrs := append(attrs, attribute.String("status_code", statusCode))
			GRPCRequestCounter.Add(ctx, 1, metric.WithAttributes(finalAttrs...))
			GRPCRequestDuration.Record(ctx, duration, metric.WithAttributes(attrs...))

			return reply, err
		}
	}
}
