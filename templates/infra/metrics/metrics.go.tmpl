package metrics

import (
	"net/http"

	"github.com/go-kratos/kratos/v2/middleware/metrics"
	"github.com/prometheus/client_golang/prometheus/promhttp"
	sdkmiddleware "glprivate.quanyougame.net/backend/core-sdk-go/middleware"
	"glprivate.quanyougame.net/backend/core-sdk-go/zaplog"
	"go.opentelemetry.io/otel"
	"go.opentelemetry.io/otel/exporters/prometheus"
	"go.opentelemetry.io/otel/metric"
	sdkmetric "go.opentelemetry.io/otel/sdk/metric"
	"go.uber.org/zap"

	"[[.Module]]/infra/conf"
)

var (
	HTTPRequestCounter   metric.Int64Counter
	HTTPRequestDuration  metric.Float64Histogram
	HTTPRequestsInFlight metric.Int64UpDownCounter

	GRPCRequestCounter   metric.Int64Counter
	GRPCRequestDuration  metric.Float64Histogram
	GRPCRequestsInFlight metric.Int64UpDownCounter

	MetricRequests metric.Int64Counter
	MetricSeconds  metric.Float64Histogram

	promHandler http.Handler
)

// Metrics Prometheus / OTel 指标收集器。
type Metrics struct{}

// NewMetrics 初始化 Prometheus exporter 与 HTTP/gRPC 指标。
func NewMetrics() *Metrics {
	exporter, err := prometheus.New()
	if err != nil {
		zaplog.Log().Fatal("failed to create prometheus exporter", zap.Error(err))
	}

	provider := sdkmetric.NewMeterProvider(sdkmetric.WithReader(exporter))
	otel.SetMeterProvider(provider)

	meter := provider.Meter(conf.GetServerName())

	httpMetrics, err := sdkmiddleware.NewHTTPMetrics(meter)
	if err != nil {
		panic(err)
	}
	HTTPRequestCounter = httpMetrics.RequestCounter
	HTTPRequestDuration = httpMetrics.RequestDuration
	HTTPRequestsInFlight = httpMetrics.RequestsInFlight

	grpcMetrics, err := sdkmiddleware.NewGRPCMetrics(meter)
	if err != nil {
		panic(err)
	}
	GRPCRequestCounter = grpcMetrics.RequestCounter
	GRPCRequestDuration = grpcMetrics.RequestDuration
	GRPCRequestsInFlight = grpcMetrics.RequestsInFlight

	MetricRequests, err = metrics.DefaultRequestsCounter(meter, metrics.DefaultServerRequestsCounterName)
	if err != nil {
		zaplog.Log().Fatal("failed to create requests counter", zap.Error(err))
	}

	MetricSeconds, err = metrics.DefaultSecondsHistogram(meter, metrics.DefaultServerSecondsHistogramName)
	if err != nil {
		zaplog.Log().Fatal("failed to create seconds histogram", zap.Error(err))
	}

	promHandler = promhttp.Handler()
	return &Metrics{}
}

// GetPrometheusHandler 返回 Prometheus metrics HTTP handler。
func GetPrometheusHandler() http.Handler {
	return promHandler
}
