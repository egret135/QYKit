package server

import (
	"time"

	"github.com/go-kratos/kratos/v2/middleware/metadata"
	"github.com/go-kratos/kratos/v2/middleware/metrics"
	"github.com/go-kratos/kratos/v2/middleware/recovery"
	"github.com/go-kratos/kratos/v2/middleware/tracing"
	khttp "github.com/go-kratos/kratos/v2/transport/http"
	sdkmiddleware "glprivate.quanyougame.net/backend/core-sdk-go/middleware"

	"[[.Module]]/biz/handler"
	"[[.Module]]/infra/conf"
	"[[.Module]]/infra/health"
	infra_metrics "[[.Module]]/infra/metrics"
)

// NewHTTPServer 创建 HTTP server 并注册路由。
func NewHTTPServer(c *conf.Server, greeter *handler.GreeterHandler) *khttp.Server {
	opts := []khttp.ServerOption{
		khttp.Middleware(
			tracing.Server(),
			metrics.Server(
				metrics.WithSeconds(infra_metrics.MetricSeconds),
				metrics.WithRequests(infra_metrics.MetricRequests),
			),
			sdkmiddleware.HTTPOtelMetrics(
				infra_metrics.HTTPRequestCounter,
				infra_metrics.HTTPRequestDuration,
				infra_metrics.HTTPRequestsInFlight,
			),
			recovery.Recovery(),
			metadata.Server(),
			sdkmiddleware.ServerLog(),
		),
	}
	if c.HTTP.Network != "" {
		opts = append(opts, khttp.Network(c.HTTP.Network))
	}
	if c.HTTP.Addr != "" {
		opts = append(opts, khttp.Address(c.HTTP.Addr))
	}
	if d, err := time.ParseDuration(c.HTTP.Timeout); err == nil && d > 0 {
		opts = append(opts, khttp.Timeout(d))
	}

	srv := khttp.NewServer(opts...)
	health.RegisterHealthHTTP(srv)
	srv.Handle("/metrics", infra_metrics.GetPrometheusHandler())
	greeter.RegisterHTTP(srv)
	return srv
}
