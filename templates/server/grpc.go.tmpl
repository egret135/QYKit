package server

import (
	"time"

	"github.com/go-kratos/kratos/v2/middleware/metadata"
	"github.com/go-kratos/kratos/v2/middleware/metrics"
	"github.com/go-kratos/kratos/v2/middleware/recovery"
	"github.com/go-kratos/kratos/v2/middleware/tracing"
	kgrpc "github.com/go-kratos/kratos/v2/transport/grpc"
	sdkmiddleware "gl.quanyougame.net/common/core-sdk-go/middleware"

	"[[.Module]]/infra/conf"
	infra_metrics "[[.Module]]/infra/metrics"
)

// NewGRPCServer 创建 gRPC server。
// 接入 protobuf 服务后，在此通过 pb.RegisterXxxServer(srv, handler) 注册。
func NewGRPCServer(c *conf.Server) *kgrpc.Server {
	opts := []kgrpc.ServerOption{
		kgrpc.Middleware(
			tracing.Server(),
			metrics.Server(
				metrics.WithSeconds(infra_metrics.MetricSeconds),
				metrics.WithRequests(infra_metrics.MetricRequests),
			),
			sdkmiddleware.GRPCOtelMetrics(
				infra_metrics.GRPCRequestCounter,
				infra_metrics.GRPCRequestDuration,
				infra_metrics.GRPCRequestsInFlight,
			),
			recovery.Recovery(),
			metadata.Server(),
			sdkmiddleware.ServerLog(),
		),
	}
	if c.Grpc != nil {
		if c.Grpc.Network != "" {
			opts = append(opts, kgrpc.Network(c.Grpc.Network))
		}
		if c.Grpc.Addr != "" {
			opts = append(opts, kgrpc.Address(c.Grpc.Addr))
		}
		if d, err := time.ParseDuration(c.Grpc.Timeout); err == nil && d > 0 {
			opts = append(opts, kgrpc.Timeout(d))
		}
	}

	return kgrpc.NewServer(opts...)
}
