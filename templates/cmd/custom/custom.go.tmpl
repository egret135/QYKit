package main

import (
	mysqlSDK "gl.quanyougame.net/common/core-sdk-go/mysql"
	sdk "gl.quanyougame.net/common/core-sdk-go/nacos"
	"gorm.io/gen"
	"gorm.io/gorm"
)

// mysqlAlias 为该服务在 Nacos 中对应的 MySQL 配置别名，按实际情况修改。
const mysqlAlias = "[[.AppName]]"

func main() {
	// 连接 Nacos 配置中心，读取 MySQL 连接信息。
	// 本地执行时请确保能访问 Nacos，或改为直连 DSN。
	sdk.NewConfCenter("http://nscode.quanyougame.net", 8848, "")
	generateTables()
}

// generateTables 使用 gorm.io/gen 从数据库表生成 model 与 query 代码。
// 文档：https://gorm.io/zh_CN/gen/index.html
func generateTables() {
	g := gen.NewGenerator(gen.Config{
		OutPath:           "infra/mysql/query",
		ModelPkgPath:      "infra/mysql/po",
		Mode:              gen.WithoutContext | gen.WithDefaultQuery | gen.WithQueryInterface,
		FieldWithIndexTag: true,
		FieldWithTypeTag:  true,
	})

	gormDB, err := mysqlSDK.NewMySQL(mysqlAlias)
	if err != nil {
		panic(err)
	}
	g.UseDB(gormDB)

	// decimal 类型映射为 shopspring/decimal。
	g.WithDataTypeMap(map[string]func(columnType gorm.ColumnType) (dataType string){
		"decimal": func(columnType gorm.ColumnType) (dataType string) {
			return "decimal.Decimal"
		},
	})

	// 在此登记需要生成的表名，执行 make gorm_gen 后自动生成到 infra/mysql/po 与 infra/mysql/query。
	g.ApplyBasic(
		// g.GenerateModel("example"),
	)

	g.Execute()
}
