package main

import (
	"os"

	"github.com/go-kratos/kratos/v2"
	"github.com/go-kratos/kratos/v2/log"
	"github.com/go-kratos/kratos/v2/registry"
	kgrpc "github.com/go-kratos/kratos/v2/transport/grpc"
	khttp "github.com/go-kratos/kratos/v2/transport/http"
	"github.com/xxl-job/xxl-job-executor-go"
	nacosSdk "gl.quanyougame.net/common/core-sdk-go/nacos"
	"gl.quanyougame.net/common/core-sdk-go/zaplog"

	rabbitConsumer "[[.Module]]/infra/rabbitmq/consumer"
	taskConsumer "[[.Module]]/infra/task/consumer"

	"[[.Module]]/infra/conf"
	"[[.Module]]/infra/metrics"
	"[[.Module]]/infra/rpc"
	"[[.Module]]/pkg/utils"
)

const serviceType = "task"

// Version 由构建时通过 -ldflags 注入。
var Version = "dev"

var id, _ = os.Hostname()

// newApp 组装 Kratos 应用（Task 服务），并在启动期拉起 RabbitMQ、asynq 消费者与 XXL-Job 执行器。
func newApp(s *conf.Server, logger log.Logger, _ *metrics.Metrics, r registry.Registrar, _ *nacosSdk.ConfCenter,
	gs *kgrpc.Server, hs *khttp.Server, rabbitMQConsumer *rabbitConsumer.Consumer,
	asynqConsumer *taskConsumer.TaskConsumer, _ xxl.Executor) *kratos.App {
	_ = rabbitMQConsumer
	_ = asynqConsumer
	opts := []kratos.Option{
		kratos.ID(id),
		kratos.Name(s.ServerName),
		kratos.Version(Version),
		kratos.Metadata(map[string]string{"service_type": serviceType}),
		kratos.Logger(logger),
		kratos.Server(gs, hs),
	}
	if utils.GetRawAppEnv() != "" {
		opts = append(opts, kratos.Registrar(r))
	}
	return kratos.New(opts...)
}

func main() {
	app, cleanup, err := wireApp()
	if err != nil {
		panic(err)
	}
	defer cleanup()

	// 服务发现，初始化 RPC 客户端（需在 Nacos 注册中心就绪后调用）。
	rpc.InitRpcClient()

	zaplog.Log().Info("success start TASK server")
	if err := app.Run(); err != nil {
		panic(err)
	}
}
