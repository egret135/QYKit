package utils

import "os"

// GetAppEnv 返回当前环境，目前约定 dev / test / prod，默认 dev。
func GetAppEnv() string {
	env := os.Getenv("APP_ENV")
	if env == "" {
		env = "dev"
	}
	return env
}

// GetRawAppEnv 返回原始 APP_ENV（可能为空）。
func GetRawAppEnv() string {
	return os.Getenv("APP_ENV")
}

// IsProd 是否生产环境。
func IsProd() bool {
	return GetAppEnv() == "prod"
}

// IsDev 是否开发环境。
func IsDev() bool {
	return GetAppEnv() == "dev"
}
