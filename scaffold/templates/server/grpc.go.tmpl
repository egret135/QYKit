package server

import (
	"time"

	"github.com/go-kratos/kratos/v2/middleware/recovery"
	"github.com/go-kratos/kratos/v2/middleware/tracing"
	kgrpc "github.com/go-kratos/kratos/v2/transport/grpc"

	"[[.Module]]/infra/conf"
)

// NewGRPCServer 创建 gRPC server。
// 接入 protobuf 服务后，在此通过 pb.RegisterXxxServer(srv, handler) 注册。
func NewGRPCServer(c *conf.Server) *kgrpc.Server {
	opts := []kgrpc.ServerOption{
		kgrpc.Middleware(
			recovery.Recovery(),
			tracing.Server(),
		),
	}
	if c.GRPC.Network != "" {
		opts = append(opts, kgrpc.Network(c.GRPC.Network))
	}
	if c.GRPC.Addr != "" {
		opts = append(opts, kgrpc.Address(c.GRPC.Addr))
	}
	if d, err := time.ParseDuration(c.GRPC.Timeout); err == nil && d > 0 {
		opts = append(opts, kgrpc.Timeout(d))
	}

	return kgrpc.NewServer(opts...)
}
